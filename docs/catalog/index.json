{
  "topics": [
    {
      "id": "101",
      "title": "101",
      "description": "Probability, linear algebra, calculus and self-contained coding."
    },
    {
      "id": "search-logic",
      "title": "Search, Logic & Optimization",
      "description": "Reason about discrete states, constraints, routes, programs or schedules."
    },
    {
      "id": "tabular-ml",
      "title": "Tabular & Classical ML",
      "description": "Predict, cluster or rank from structured features."
    },
    {
      "id": "data-quality",
      "title": "Data Quality & Evaluation",
      "description": "Feature design, noise, labels, robustness, validation and interpreting failures."
    },
    {
      "id": "model-internals",
      "title": "Model Internals & Efficiency",
      "description": "Implement or debug model components, training algorithms and computational constraints."
    },
    {
      "id": "vision-geometry",
      "title": "Vision & Geometry",
      "description": "Images, video, detection, masks, reconstruction and spatial geometry."
    },
    {
      "id": "text-language",
      "title": "Text & Language",
      "description": "Text classification, retrieval, tokenization, translation and language analysis."
    },
    {
      "id": "audio-speech",
      "title": "Audio & Speech",
      "description": "Learning from or transforming waveforms, speech, sound and music."
    },
    {
      "id": "time-series",
      "title": "Time Series, Sensors & Scientific Modeling",
      "description": "Forecasting, non-audio measurements, dynamical systems and inverse problems."
    },
    {
      "id": "agents-control",
      "title": "Agents, Games & Control",
      "description": "Choose actions in a simulator, game or physical system. Includes reinforcement learning."
    },
    {
      "id": "multimodal",
      "title": "Multimodal Learning",
      "description": "Fuse distinct kinds of input or match information across them."
    }
  ],
